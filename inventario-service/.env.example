# Copia este archivo a .env (no se sube al repositorio) y ajusta los valores.
# Valores de desarrollo local; no uses estas credenciales fuera de tu máquina.
# El puerto de DB_URL debe coincidir con el mapeo de compose.yml (15433:5432).
DB_URL=jdbc:postgresql://localhost:15433/inventario_db
DB_USERNAME=devdb
DB_PASSWORD=devdb
