# Credenciales de PRUEBA para el clúster local (kind). No son secretos reales ni sirven fuera de esta máquina.
# Kustomize las convierte en el Secret gestilab-credenciales. Para otro entorno, se reemplaza este archivo
# por uno propio que NO se versiona.
DB_USERNAME=devdb
DB_PASSWORD=devdb
RABBITMQ_USER=gestilab
RABBITMQ_PASSWORD=gestilab-prueba
S3_ACCESS_KEY=gestilab
S3_SECRET_KEY=gestilab-prueba
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
