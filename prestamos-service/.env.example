# Copia este archivo a .env (no se sube al repositorio) y ajusta los valores.
# Valores de desarrollo local; no uses estas credenciales fuera de tu máquina.
# El puerto de DB_URL debe coincidir con el mapeo de compose.yml (15434:5432).
DB_URL=jdbc:postgresql://localhost:15434/prestamos_db
DB_USERNAME=devdb
DB_PASSWORD=devdb
# Dirección de inventario-service (con el prefijo de la API) y tiempo máximo de espera de cada llamada.
INVENTARIO_URL=http://localhost:8080/api/v1/inventario-service
INVENTARIO_TIMEOUT=3s
